; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Brawl & Chain — Private Visual Preview"
run/main_scene="res://scenes/visual_preview.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[input]

move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":65,"unicode":97)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":68,"unicode":100)]
}
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":87,"unicode":119)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":83,"unicode":115)]
}
strike={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":74,"unicode":106)]
}
guard={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":75,"unicode":107)]
}
reset_exchange={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":82,"unicode":114)]
}
heavy_strike={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":76,"unicode":108)]
}

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.065, 1)
